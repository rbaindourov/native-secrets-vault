[Unit]
Description=Native Secrets Vault (Zero-Docker Cryptographic KV v2 Daemon)
After=network.target

[Service]
Type=simple
User=robert
Group=robert
WorkingDirectory=/opt/native-secrets-vault
Environment="NODE_ENV=production"
Environment="NSV_HOST=127.0.0.1"
Environment="NSV_PORT=8200"
Environment="NSV_DATA_DIR=/var/lib/native-secrets-vault"
Environment="NSV_AUTO_UNSEAL_FILE=/var/lib/native-secrets-vault/unseal-init.json"
ExecStart=/usr/bin/node /opt/native-secrets-vault/dist/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
